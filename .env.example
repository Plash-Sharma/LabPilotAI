# Backend Database (PostgreSQL with pgvector)
# Local: postgresql+asyncpg://postgres:postgres@localhost:5433/labpilotai
# Supabase / Neon: postgresql+asyncpg://postgres.yourproject:pass@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/labpilotai

# Redis / Celery (Optional - set USE_CELERY=false for free single-instance hosting)
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0

# Object Storage (PDFs)
# 100% Free Option: Cloudflare R2 (10GB free, $0 egress fees, S3-compatible)
# Or leave blank to store PDFs locally in ./storage
S3_BUCKET_NAME=labpilotai-pdfs
S3_ENDPOINT_URL=https://<your-account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto

# Gemini API (RAG Viva questions & Dynamic MCQ generation)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# JWT Auth
SECRET_KEY=change-me-in-production-use-a-strong-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (Comma-separated URLs for frontend allowed access)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Frontend URL (Used for generating reset password links)
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Password Reset Links via Gmail / Mail Server)
# For Gmail: Use an App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true
